// Subconjunto do schema do Agent-Api (mesmo Postgres, schema `public`). Migrations
// só existem em Agent-Api/prisma/migrations. Qualquer mudança de coluna precisa ser
// espelhada manualmente aqui. Rodar apenas `prisma generate`, nunca `prisma migrate`.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id
  name             String
  email            String
  emailVerified    Boolean       @default(false)
  image            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  role             String?
  banned           Boolean?      @default(false)
  banReason        String?
  banExpires       DateTime?
  members          Member[]
  queueMemberships QueueMember[]
  assignedTickets  Ticket[]

  @@unique([email])
  @@map("user")
}

model Organization {
  id        String   @id
  name      String
  slug      String
  logo      String?
  createdAt DateTime
  metadata  String?
  cnpj      String
  status    String?  @default("ACTIVE")

  members          Member[]
  agents           Agent[]
  whatsappChannels WhatsappChannel[]
  serviceIslands   ServiceIsland[]
  targets          Target[]
  tickets          Ticket[]
  ticketCounter    TicketCounter?

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Agent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isActive       Boolean      @default(true)

  welcomeMessage           String
  welcomeEnabled           Boolean @default(true)
  processingMessage        String
  transferMessage          String
  unsupportedFormatMessage String
  outOfHoursMessage        String
  outOfHoursEnabled        Boolean @default(true)
  closingMessage           String
  closingEnabled           Boolean @default(true)
  errorMessage             String
  errorEnabled              Boolean @default(true)

  defaultQueueId String?
  defaultQueue   Queue?  @relation(fields: [defaultQueueId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  whatsappChannels WhatsappChannel[]

  @@index([organizationId])
  @@index([defaultQueueId])
}

model WhatsappChannel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  phoneNumberId String @unique
  displayNumber String
  wabaId        String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceIsland ServiceIsland?
  targets       Target[]

  @@index([organizationId])
  @@index([agentId])
}

model ServiceIsland {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappChannelId String          @unique
  whatsappChannel   WhatsappChannel @relation(fields: [whatsappChannelId], references: [id], onDelete: Cascade)
  name              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queues Queue[]

  @@index([organizationId])
}

model Queue {
  id              String        @id @default(cuid())
  serviceIslandId String
  serviceIsland   ServiceIsland @relation(fields: [serviceIslandId], references: [id], onDelete: Cascade)
  name            String

  businessHoursEnabled Boolean @default(false)
  businessHoursStart   String?
  businessHoursEnd     String?
  businessDays         Int[]   @default([1, 2, 3, 4, 5])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          QueueMember[]
  tickets          Ticket[]
  defaultForAgents Agent[]

  @@index([serviceIslandId])
}

model QueueMember {
  id        String   @id @default(cuid())
  queueId   String
  queue     Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([queueId, userId])
  @@index([userId])
}

enum TargetStatus {
  AI
  HUMAN
  FINISHED
}

model Target {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappChannelId String
  whatsappChannel   WhatsappChannel @relation(fields: [whatsappChannelId], references: [id], onDelete: Cascade)

  waId     String
  name     String?
  email    String?
  metadata Json?

  status             TargetStatus @default(AI)
  firstInteractionAt DateTime     @default(now())
  lastInteractionAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messagingSessions MessagingSession[]
  tickets           Ticket[]

  @@unique([organizationId, whatsappChannelId, waId])
  @@index([organizationId])
  @@index([whatsappChannelId])
}

enum SessionOrigin {
  CUSTOMER_MESSAGE
  CAMPAIGN_TEMPLATE
}

model MessagingSession {
  id                String   @id @default(cuid())
  targetId          String
  target            Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  whatsappChannelId String

  createdVia             SessionOrigin @default(CUSTOMER_MESSAGE)
  startedAt              DateTime      @default(now())
  lastCustomerMessageAt  DateTime      @default(now())
  lastAttendantMessageAt DateTime?

  createdAt DateTime @default(now())

  tickets Ticket[]

  @@index([targetId])
  @@index([whatsappChannelId])
}

enum TicketStatus {
  WAITING
  IN_PROGRESS
  CLOSED
}

enum TicketCloseReason {
  RESOLVED
  TRANSFERRED_QUEUE
  TRANSFERRED_AGENT
  SESSION_EXPIRED
  ABANDONED
}

model Ticket {
  id             String       @id @default(cuid())
  ticketNumber   Int
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queueId        String
  queue          Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)
  targetId       String
  target         Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)

  messagingSessionId String
  messagingSession   MessagingSession @relation(fields: [messagingSessionId], references: [id], onDelete: Cascade)

  status TicketStatus @default(WAITING)

  assignedUserId String?
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedAt     DateTime?

  transferredFromTicketId String?
  transferredFromTicket   Ticket?  @relation("TicketTransferChain", fields: [transferredFromTicketId], references: [id], onDelete: SetNull)
  transferredToTickets    Ticket[] @relation("TicketTransferChain")

  closeReason TicketCloseReason?

  lastWaitingMessageSentAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  messages TicketMessage[]

  @@unique([organizationId, ticketNumber])
  @@index([queueId])
  @@index([targetId])
  @@index([messagingSessionId])
  @@index([assignedUserId])
}

model TicketCounter {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastNumber     Int          @default(0)
}

enum TicketMessageSender {
  CUSTOMER
  ATTENDANT
  SYSTEM
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  STICKER
}

model TicketMessage {
  id             String              @id @default(cuid())
  ticketId       String
  ticket         Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType     TicketMessageSender
  senderUserId   String?
  mongoMessageId String?
  messageType    MessageType         @default(TEXT)
  createdAt      DateTime            @default(now())

  @@index([ticketId])
}

model ProcessedInboundMessage {
  id                String   @id @default(cuid())
  externalMessageId String   @unique
  whatsappChannelId String
  processedAt       DateTime @default(now())

  @@index([whatsappChannelId])
}
